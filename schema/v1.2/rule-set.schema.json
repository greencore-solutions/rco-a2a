{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://rco-a2a.ai/schema/v1.2/rule-set-v1.json",
 "title": "RCO rule set v1 (spec v1.2, NG-11 §2j BOUND)",
 "$comment": "One rule set per jurisdiction, authored from the CPG Knowledge Graph's eligibility logic. Resolution is a pure total function: evaluate rules in array order against the ECO-10060 object; the first rule whose predicates ALL match fires; if none fires, default applies. Predicates address the ECO object by RFC 6901 JSON Pointer; a missing pointer target matches only `absent`. Operator semantics (v1.2, in-schema below): exists/absent take no value; eq/ne compare a scalar with strict type equality (no coercion; type mismatch = no match); gte/lte compare numbers only (non-number operand = no match); in/not_in take an array of scalars, strict membership. Hash of record = sha256 over the RFC 8785 canonical JSON of this whole document with the signature member removed. Versioning CalVer YYYY.MM[.n]; a changed rule set is a new version, never an edit.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "rule_set_version",
  "id",
  "version",
  "jurisdiction",
  "effective_from",
  "rules",
  "default",
  "issuer",
  "key_id",
  "verification_url",
  "signature"
 ],
 "properties": {
  "rule_set_version": {
   "const": "1.0"
  },
  "id": {
   "type": "string",
   "pattern": "^[A-Z]{2}-ECO-10060$|^apex$"
  },
  "version": {
   "type": "string",
   "pattern": "^20[0-9]{2}\\.(0[1-9]|1[0-2])(\\.[0-9]+)?$"
  },
  "jurisdiction": {
   "type": "string",
   "pattern": "^([A-Z]{2}-ECO-10060|apex)$"
  },
  "effective_from": {
   "type": "string",
   "format": "date-time"
  },
  "effective_to": {
   "anyOf": [
    {
     "type": "null"
    },
    {
     "type": "string",
     "format": "date-time"
    }
   ]
  },
  "rules": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "rule_id",
     "when",
     "then"
    ],
    "properties": {
     "rule_id": {
      "type": "string",
      "pattern": "^[A-Z0-9-]+$"
     },
     "citation": {
      "type": "string",
      "format": "uri",
      "$comment": "Pointer to the regulation source consulted at authoring. Never the regulation text."
     },
     "when": {
      "type": "array",
      "minItems": 0,
      "$comment": "Conjunction; an empty array is the explicit always-true catch-all (v1.2).",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "path",
        "op"
       ],
       "properties": {
        "path": {
         "type": "string",
         "pattern": "^(/[^/]*)+$",
         "$comment": "RFC 6901 JSON Pointer into the ECO-10060 object."
        },
        "op": {
         "enum": [
          "exists",
          "absent",
          "eq",
          "ne",
          "in",
          "not_in",
          "gte",
          "lte"
         ]
        },
        "value": {
         "$comment": "Constrained per operator by the allOf below."
        }
       },
       "allOf": [
        {
         "if": {
          "properties": {
           "op": {
            "enum": [
             "exists",
             "absent"
            ]
           }
          }
         },
         "then": {
          "not": {
           "required": [
            "value"
           ]
          }
         }
        },
        {
         "if": {
          "properties": {
           "op": {
            "enum": [
             "eq",
             "ne"
            ]
           }
          }
         },
         "then": {
          "required": [
           "value"
          ],
          "properties": {
           "value": {
            "type": [
             "string",
             "number",
             "boolean"
            ]
           }
          }
         }
        },
        {
         "if": {
          "properties": {
           "op": {
            "enum": [
             "gte",
             "lte"
            ]
           }
          }
         },
         "then": {
          "required": [
           "value"
          ],
          "properties": {
           "value": {
            "type": "number"
           }
          }
         }
        },
        {
         "if": {
          "properties": {
           "op": {
            "enum": [
             "in",
             "not_in"
            ]
           }
          }
         },
         "then": {
          "required": [
           "value"
          ],
          "properties": {
           "value": {
            "type": "array",
            "minItems": 1,
            "items": {
             "type": [
              "string",
              "number",
              "boolean"
             ]
            }
           }
          }
         }
        }
       ]
      }
     },
     "then": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "signal",
       "state"
      ],
      "properties": {
       "signal": {
        "enum": [
         "CPG-000",
         "CPG-200",
         "CPG-300",
         "CPG-403"
        ]
       },
       "state": {
        "enum": [
         "NOT_APPLICABLE",
         "ALLOW",
         "CONDITIONAL",
         "RESTRICT"
        ]
       },
       "conditions": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "code",
          "ref"
         ],
         "properties": {
          "code": {
           "type": "string",
           "minLength": 1
          },
          "ref": {
           "type": "string",
           "format": "uri"
          }
         }
        }
       }
      },
      "allOf": [
       {
        "oneOf": [
         {
          "properties": {
           "signal": {
            "const": "CPG-000"
           },
           "state": {
            "const": "NOT_APPLICABLE"
           }
          }
         },
         {
          "properties": {
           "signal": {
            "const": "CPG-200"
           },
           "state": {
            "const": "ALLOW"
           }
          }
         },
         {
          "properties": {
           "signal": {
            "const": "CPG-300"
           },
           "state": {
            "const": "CONDITIONAL"
           }
          }
         },
         {
          "properties": {
           "signal": {
            "const": "CPG-403"
           },
           "state": {
            "const": "RESTRICT"
           }
          }
         }
        ]
       },
       {
        "if": {
         "properties": {
          "signal": {
           "const": "CPG-300"
          }
         }
        },
        "then": {
         "required": [
          "conditions"
         ],
         "properties": {
          "conditions": {
           "minItems": 1
          }
         }
        },
        "else": {
         "not": {
          "required": [
           "conditions"
          ]
         }
        }
       }
      ]
     }
    }
   }
  },
  "default": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "signal",
    "state"
   ],
   "properties": {
    "signal": {
     "enum": [
      "CPG-000",
      "CPG-200",
      "CPG-300",
      "CPG-403"
     ]
    },
    "state": {
     "enum": [
      "NOT_APPLICABLE",
      "ALLOW",
      "CONDITIONAL",
      "RESTRICT"
     ]
    },
    "conditions": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "code",
       "ref"
      ],
      "properties": {
       "code": {
        "type": "string"
       },
       "ref": {
        "type": "string",
        "format": "uri"
       }
      }
     }
    }
   },
   "allOf": [
    {
     "oneOf": [
      {
       "properties": {
        "signal": {
         "const": "CPG-000"
        },
        "state": {
         "const": "NOT_APPLICABLE"
        }
       }
      },
      {
       "properties": {
        "signal": {
         "const": "CPG-200"
        },
        "state": {
         "const": "ALLOW"
        }
       }
      },
      {
       "properties": {
        "signal": {
         "const": "CPG-300"
        },
        "state": {
         "const": "CONDITIONAL"
        }
       }
      },
      {
       "properties": {
        "signal": {
         "const": "CPG-403"
        },
        "state": {
         "const": "RESTRICT"
        }
       }
      }
     ]
    },
    {
     "if": {
      "properties": {
       "signal": {
        "const": "CPG-300"
       }
      }
     },
     "then": {
      "required": [
       "conditions"
      ],
      "properties": {
       "conditions": {
        "minItems": 1
       }
      }
     },
     "else": {
      "not": {
       "required": [
        "conditions"
       ]
      }
     }
    }
   ]
  },
  "issuer": {
   "type": "object",
   "required": [
    "id",
    "rail",
    "name"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z0-9-]+$"
    },
    "rail": {
     "enum": [
      "bpc",
      "cpg"
     ]
    },
    "name": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "key_id": {
   "type": "string",
   "minLength": 1
  },
  "verification_url": {
   "type": "string",
   "format": "uri"
  },
  "signature": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_-]+\\.\\.[A-Za-z0-9_-]+$",
   "description": "Same detached-JWS profile as the RCO record."
  }
 }
}